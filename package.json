{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "description": "An agentic marketing platform — an AI agent that plans and executes campaigns end to end.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:reset": "node scripts/reset.mjs",
    "test": "npm run test:resources && npm run test:api",
    "test:resources": "tsx --test tests/resources.test.mts",
    "test:api": "node --test tests/api.test.mjs",
    "test:audit": "node tests/audit.mjs",
    "shots": "node tests/docshots.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "15.5.22",
    "react": "19.0.8",
    "react-dom": "19.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
