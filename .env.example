# ---------------------------------------------------------------------------
# Pulse runs with NO configuration at all.
#
# Without a key the agent console runs in DEMO mode: a scripted run that calls
# the same real tools against the same real database and emits the same event
# types, so every screen behaves identically. Set the key below to swap the
# scripted planner for Claude. Nothing else changes.
# ---------------------------------------------------------------------------

# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for agent runs. Defaults to claude-opus-5.
# Cheaper alternatives: claude-sonnet-5, claude-haiku-4-5
PULSE_MODEL=claude-opus-5

# Reasoning depth: low | medium | high | xhigh | max. Defaults to high.
# This is the primary cost lever — Opus 5 is unusually strong at medium.
PULSE_EFFORT=high

# Where the SQLite file lives. Defaults to ./data/pulse.db
PULSE_DB=

# Shared secret for POST /api/cron/tick so the queue drain isn't world-callable.
# Leave blank in development to allow unauthenticated local ticks.
CRON_SECRET=
